// Esquema de datos del módulo "Gestión de precios".
// Ver /CLAUDE.md para el contexto de negocio detrás de cada campo.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" para poder seguir desarrollando en este entorno Linux;
  // "windows" para que el motor de Prisma quede incluido en el instalador
  // que corre en el PC de la carnicería.
  binaryTargets = ["native", "windows"]
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  // --- Módulo Charcutería ---
  // Rol fijo para autorizar acciones del módulo de charcutería (admin ve
  // costos/márgenes y edita vida útil/vencimiento; producción crea lotes y
  // envasa; caja vende) — no afecta nada fuera de este módulo: el resto del
  // sistema sigue sin roles, usando "cualquier usuario activo" + la clave de
  // supervisor compartida (ClaveSupervisor) como hasta ahora.
  rol String @default("caja") // "admin" | "produccion" | "caja"

  // PIN/clave propia del usuario, solo para las acciones de charcutería que
  // piden confirmar identidad (ej. editar vencimiento) — null hasta que el
  // usuario la configure. A diferencia de ClaveSupervisor (una sola clave
  // compartida para todo el sistema), esta es personal e intransferible.
  // Mismo hash que ClaveSupervisor (ver server/lib/clave.ts), nunca en
  // texto plano.
  hashClavePersonal String?

  cambiosPrecio         HistorialPrecio[]
  movimientosInventario MovimientoInventario[]

  itemsCharcuteriaCreados          ItemCharcuteria[]
  preciosTransferenciaCreados      PrecioTransferencia[]
  transferenciasInternasResponsable TransferenciaInterna[]
  movimientosCharcuteria           MovimientoCharcuteria[]
  recetasCreadas                   Receta[]
  lotesProduccionResponsable       LoteProduccion[]        @relation("LotesProduccionResponsable")
  cambiosVencimientoLote           LoteVencimientoCambio[]
  envasadosResponsable             Envasado[]

  sesionesAbiertas           SesionCaja[] @relation("SesionesAbiertasPorUsuario")
  sesionesCerradas           SesionCaja[] @relation("SesionesCerradasPorUsuario")
  sesionesFondoAutorizado    SesionCaja[] @relation("SesionesFondoAutorizadoPorUsuario")
  ventas                     Venta[]
  ventasAnuladas             Venta[]      @relation("VentasAnuladasPorUsuario")
  itemsAnulados              ItemVenta[]  @relation("ItemsAnuladosPorUsuario")
  cobrosDeCreditoRegistrados PagoVenta[]  @relation("CobrosDeCreditoRegistradosPorUsuario")
  gastos                     Gasto[]
  retirosCajaAutorizados     RetiroCaja[]

  cajasCamaraCreadas          CajaCamara[]
  lotesCamaraCreados          LoteCamara[]
  correccionesLoteCamara      CorreccionLoteCamara[]
  movimientosCamara           MovimientoCamara[]
  sesionesCamaraIniciadas     SesionInventarioCamara[]  @relation("SesionesCamaraIniciadasPorUsuario")
  sesionesCamaraFinalizadas   SesionInventarioCamara[]  @relation("SesionesCamaraFinalizadasPorUsuario")
  escaneosCamara              EscaneoInventarioCamara[]
  salidasMayoristaRegistradas SalidaMayorista[]
  salidasMayoristaAnuladas    SalidaMayorista[] @relation("SalidasMayoristasAnuladasPorUsuario")
  pedidosWebAtendidos         PedidoWeb[]       @relation("PedidosWebAtendidosPorUsuario")
  pedidosWebAnulados          PedidoWeb[]       @relation("PedidosWebAnuladosPorUsuario")
  regalosPedidoWebAgregados   PedidoWebRegalo[]
}

// Gastos generales del negocio (sueldos, luz, agua, arriendo, etc.) —
// separado de las compras de mercadería, que ya se registran como entradas
// de inventario (con su propio proveedor/costo).
model Gasto {
  id Int @id @default(autoincrement())

  fecha       DateTime @default(now())
  categoria   String // ej. "Sueldos", "Luz", "Agua", "Arriendo", "Otros"
  descripcion String?
  monto       Float

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

// Categorías jerárquicas de 3 niveles, ej: 01 Aves > 0101 Pollos > 010101 Trutros.
model Categoria {
  id     Int    @id @default(autoincrement())
  codigo String @unique
  nombre String
  nivel  Int

  padreId Int?
  padre   Categoria?  @relation("CategoriaJerarquia", fields: [padreId], references: [id])
  hijos   Categoria[] @relation("CategoriaJerarquia")

  productos Producto[]
}

// SQLite no soporta enums nativos en Prisma; el valor permitido
// ("NORMAL" | "PESABLE" | "IMPORTE") se valida en la capa de API (zod).
model Producto {
  id          Int     @id @default(autoincrement())
  plu         String  @unique
  descripcion String
  nombreCorto String?
  marca       String?

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  // Unidad de negocio dueña de este producto — por defecto "carniceria"
  // (id 1, ver seed de BusinessUnit), así que todo producto que ya existía
  // antes de este campo queda asignado ahí sin tocarlo a mano. Un producto
  // de charcutería solo aparece acá como fila "espejo" de un SKU vendible
  // (ItemCharcuteria.productoEspejoId) — el resto del catálogo de
  // charcutería (materia prima, insumos, producto elaborado) vive aparte,
  // en ItemCharcuteria, nunca en esta tabla.
  businessUnitId Int          @default(1)
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])

  // Precio por kg si flagBalanza es PESABLE/IMPORTE, precio por unidad si es NORMAL.
  precio Float

  // Precio de venta al por mayor (opcional) — de referencia, editable
  // directo (a diferencia de "precio", no pasa por el historial de
  // cambios de precio). No reemplaza el precio que se negocia en cada
  // "Venta por mayor" de Cámara — es solo un valor guardado para
  // consultarlo rápido al armar una factura o cotizar.
  precioMayor Float?

  // Costo ingresado a mano (ej. desde datos del sistema anterior, cuando
  // todavía no hay una factura real cargada para ese producto) — a pedido
  // del usuario, para poder ver el margen reflejado mientras se junta el
  // respaldo real. Es solo un respaldo: en cuanto haya una compra real
  // registrada en Inventario/Cámara, esa manda por sobre este valor en
  // todas las pantallas de margen (ver costoEfectivo, calculado en el
  // servidor, nunca guardado).
  costoReferencia Float?

  flagBalanza String @default("NORMAL")

  // Solo aplica cuando flagBalanza = NORMAL: la balanza imprime su propio
  // código con peso/precio embebido para productos pesables/importe.
  codigoBarras String? @unique

  contenido         String?
  capacidadPorCaja  String?
  envase            String?
  impuestoAdicional Float?  @default(0)
  duracion          String?
  codigoProveedor   String?

  // Marca los productos de vacuno/cerdo a los que les corresponde el IVA
  // adicional a la carne (5%) — a pedido del usuario, para que "Cargar
  // factura" y "Entrada de cámara" puedan precargar solas ese impuesto por
  // línea (igual se puede destildar por línea si un producto puntual no
  // lo tiene). Se marca a mano en la ficha del producto, no se deduce de
  // la categoría.
  aplicaIvaCarne Boolean @default(false)

  // Se creó al vuelo desde Caja al escanear un código que no existía en el
  // catálogo (ver POST /api/caja/ventas/:id/items/crear-rapido), con solo
  // los datos mínimos para poder cobrar en el momento — queda marcado true
  // hasta que alguien lo complete en Productos (pestaña "Revisión rápida"),
  // donde se limpia la marca al guardar cualquier edición.
  creadoRapido Boolean @default(false)

  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // --- Página web (lagrancarniceria.com) ---
  // Independiente de "activo" (que es el estado general del POS): un
  // producto puede seguir activo en el POS pero no publicarse en la web.
  visibleEnWeb Boolean @default(true)

  // Toggle manual e independiente del stock interno (stockActual) — el
  // conteo de inventario no es lo bastante granular/inmediato para todos
  // los productos como para decidir solo, así que la disponibilidad en la
  // web la marca el cajero a mano. "disponible" | "agotado" |
  // "proximamente" — string en vez de enum por lo mismo que familiaCorte
  // (SQLite no soporta enums nativos).
  disponibilidadWeb String @default("disponible")

  // Destacado: aparece en el filtro "Destacados" de la web (no es un badge
  // en la tarjeta, es un filtro aparte).
  featured Boolean @default(false)
  // Pocas unidades: badge en la tarjeta, independiente de disponibilidadWeb
  // (un producto puede estar "disponible" y a la vez "con pocas unidades").
  lowStock Boolean @default(false)

  // Promoción por volumen (ej. "$3.980/kg al llevar 3 kilos o más", o para
  // un producto Normal "3 unidades a $990 c/u") — los tres campos van
  // juntos: si promoPrecioUnitario tiene valor, el producto muestra el
  // badge "Oferta" y la etiqueta en la tarjeta. promoGramosMinimos es la
  // cantidad mínima para que aplique: gramos si flagBalanza es
  // PESABLE/IMPORTE, unidades si es NORMAL (mismo campo, se interpreta
  // según flagBalanza — ver ProductoForm.tsx y CotizadorModal.tsx en la
  // web).
  promoPrecioUnitario Float?
  promoGramosMinimos  Int?
  promoEtiqueta       String?

  // Texto corto opcional para la tarjeta de producto en la web (distinto
  // de "descripcion", que es el nombre del producto) — null si no se ha
  // escrito ninguno todavía.
  descripcionCorta String?

  // Familia para el selector de corte en la web (Bifes, trozo entero,
  // medallones, picada, molida, parrilla, otros) — mismo patrón de string
  // libre que familiaNombre en Cámara (ver CajaCamara/LoteCamara), en vez
  // de un enum: SQLite no los soporta nativamente. Null = el producto no
  // muestra selector de corte. Las opciones válidas para cada familia
  // viven en CorteOpcion.
  familiaCorte String?

  // Peso promedio de un trozo/presa, en gramos — solo para productos por
  // peso (típicamente pollo/aves: trutro, ala, etc.), donde la gente suele
  // pensar la compra en "cuántos trozos" en vez de en kilos. Si tiene valor,
  // el cotizador de la web ofrece elegir por cantidad de trozos además de
  // por peso/monto, estimando el peso como trozos × este valor — sigue
  // siendo un peso aproximado, se ajusta al pesar de verdad. Null = el
  // producto no ofrece esa opción.
  pesoPromedioTrozoGramos Int?

  // Opciones de preparación por unidad, separadas por coma (ej.
  // "Entero,Trozado,Para la parrilla") — solo para productos por unidad
  // (flagBalanza NORMAL). Si tiene valor, el cotizador de la web pide una
  // elección independiente por cada unidad pedida (ej. 3 pollos enteros: 2
  // "Entero" y 1 "Para la parrilla") en vez de una sola elección para todo
  // el pedido. Distinto de familiaCorte/CorteOpcion (que es una tabla
  // compartida entre productos de la misma familia): esto es específico
  // de este producto, así que basta un texto libre. Null = el cotizador
  // no pide ninguna elección por unidad.
  opcionesUnidad String?

  // Se actualiza solo con cada movimiento de inventario (entrada/salida);
  // no se edita a mano desde la ficha del producto.
  stockActual     Float  @default(0)
  umbralStockBajo Float?

  // Combo: producto "vitrina" que junta varios productos reales en una
  // sola cotización de la web (ej. "Combo Parrillero") — solo se vende por
  // la web (ver enviarACaja en pedidosWeb.ts), nunca en Punto de Venta. No
  // tiene stock propio: al venderse, se descuenta el de sus componentes
  // (ver ComboComponente), nunca el de este producto. flagBalanza siempre
  // "NORMAL" (se cotiza como 1 combo = 1 unidad). descripcionCorta se
  // regenera sola a partir de los componentes (ver
  // regenerarDescripcionCombo en productos.ts) — no se edita a mano,
  // porque así la web muestra siempre lo que el combo trae en verdad, sin
  // depender de que alguien la actualice cada vez que cambia la receta.
  esCombo Boolean @default(false)

  historialPrecio       HistorialPrecio[]
  movimientosInventario MovimientoInventario[]
  itemsVenta            ItemVenta[]

  cajasCamara       CajaCamara[]
  lotesCamara       LoteCamara[]
  salidasMayoristas SalidaMayorista[]
  regalosPedidoWeb  PedidoWebRegalo[]

  componentesDelCombo ComboComponente[] @relation("ComponentesDelCombo")
  usadoEnCombos       ComboComponente[] @relation("ProductoUsadoEnCombos")

  // --- Módulo Charcutería ---
  // Si este producto ES el espejo vendible de un SKU de charcutería, apunta
  // de vuelta al ItemCharcuteria que lo generó (null para el resto del
  // catálogo, que es carnicería normal).
  espejoDeItemCharcuteria ItemCharcuteria?
  // Materia prima de carnicería transferida hacia charcutería (este
  // producto como origen de la transferencia).
  transferenciasComoOrigen TransferenciaInterna[]
}

// Una línea de la "receta" de un combo — qué producto real (y cuánto) lleva
// adentro. Un mismo producto puede ser componente de varios combos, y un
// combo puede tener varios componentes.
model ComboComponente {
  id Int @id @default(autoincrement())

  comboProductoId Int
  comboProducto   Producto @relation("ComponentesDelCombo", fields: [comboProductoId], references: [id])

  componenteProductoId Int
  componenteProducto   Producto @relation("ProductoUsadoEnCombos", fields: [componenteProductoId], references: [id])

  // Mismo criterio que ItemVenta.cantidad: kg si el componente es pesable,
  // unidades si es Normal.
  cantidad Float
}

model HistorialPrecio {
  id Int @id @default(autoincrement())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  precioAnterior Float
  precioNuevo    Float
  tipoCambio     String // "individual" | "individual_caja" | "masivo_categoria" | "masivo_csv"

  // Solo se llena para "individual_caja" (cambio rápido de precio hecho
  // desde Punto de venta, que pide clave de supervisor) — el resto de los
  // tipos de cambio nunca la piden, así que queda null.
  motivoAutorizacion String?

  fecha DateTime @default(now())
}

model Proveedor {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique
  contacto String?
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  movimientos MovimientoInventario[]
  lotesCamara LoteCamara[]
}

// "Entrada" siempre suma stock (compra a proveedor, o ajuste positivo por
// conteo físico sin proveedor). "Salida" siempre resta stock (venta,
// descarte/merma, o ajuste negativo). La cantidad siempre se guarda positiva;
// el signo lo da el campo tipo.
model MovimientoInventario {
  id Int @id @default(autoincrement())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo   String // "entrada" | "salida"
  motivo String // entrada: "compra" | "ajuste" | "regalo_revertido" — salida: "venta" | "descarte" | "ajuste" | "regalo_pedido_web"

  cantidad Float

  // Solo aplica a entradas por compra.
  costoUnitario Float?
  proveedorId   Int?
  proveedor     Proveedor? @relation(fields: [proveedorId], references: [id])
  numeroFactura String?

  // Por defecto "carniceria" (id 1) — todo movimiento previo a este campo
  // queda asignado ahí. Ver comentario de Producto.businessUnitId.
  businessUnitId Int          @default(1)
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])

  fecha DateTime @default(now())
}

// Clave única compartida entre supervisores (no hay cuentas/contraseñas por
// persona en este sistema). Siempre hay como máximo una fila; se sobrescribe
// al cambiarla. Se guarda hasheada, nunca en texto plano.
model ClaveSupervisor {
  id            Int      @id @default(autoincrement())
  hashClave     String
  actualizadoEn DateTime @updatedAt
}

// Configuración del asistente de IA. Guarda la clave de API de Anthropic tal
// cual (no hasheada, a diferencia de ClaveSupervisor) porque hay que poder
// volver a leerla para llamar a la API — no es una clave que solo se verifica
// por comparación. Vive en el mismo archivo local que el resto de los datos
// del negocio, en el PC de la carnicería; nunca se sube a git ni se muestra
// de vuelta al frontend una vez guardada. Siempre hay como máximo una fila.
model ConfiguracionIA {
  id                Int      @id @default(autoincrement())
  claveApiAnthropic String
  actualizadoEn     DateTime @updatedAt
}

// Direcciones IP de las balanzas (son espejo entre sí: se les manda el mismo
// catálogo a las dos). Puerto 3001 confirmado por captura de red real.
// Siempre hay como máximo una fila.
model ConfiguracionBalanza {
  id            Int      @id @default(autoincrement())
  ip1           String   @default("192.168.18.122")
  ip2           String   @default("192.168.18.120")
  puerto        Int      @default(3001)
  actualizadoEn DateTime @updatedAt
}

// Configuración y estado del respaldo automático de la base de datos — a
// pedido del usuario, para no depender de copiar el archivo a mano. El
// respaldo "local" (carpeta aparte en el mismo PC) siempre está activo; el
// respaldo a USB es opcional y solo se intenta si hay una ruta configurada
// Y ese USB está conectado en el momento (si no lo está, no es un error,
// simplemente ese respaldo puntual queda pendiente para la próxima vez).
// Siempre hay como máximo una fila (mismo patrón que ConfiguracionBalanza).
model ConfiguracionRespaldo {
  id      Int     @id @default(autoincrement())
  rutaUsb String?

  ultimoLocalEn    DateTime?
  ultimoLocalOk    Boolean?
  ultimoLocalError String?

  ultimoUsbEn    DateTime?
  ultimoUsbOk    Boolean?
  ultimoUsbError String?

  actualizadoEn DateTime @updatedAt
}

// URL de la web y llave de sync (ver server/lib/syncWeb.ts) — vive acá, no
// solo en variables de entorno, porque el instalador que llega al PC de la
// carnicería no trae ningún archivo .env: sin esto no habría forma de
// configurar el sync desde una instalación real. syncApiKey se guarda tal
// cual (no hasheada, a diferencia de ClaveSupervisor) porque hay que poder
// volver a mandarla en cada sync — nunca se muestra de vuelta al frontend
// una vez guardada, mismo patrón que ConfiguracionIA. Siempre hay como
// máximo una fila.
model ConfiguracionSyncWeb {
  id            Int      @id @default(autoincrement())
  webSyncUrl    String?
  syncApiKey    String?
  actualizadoEn DateTime @updatedAt
}

// Resumen diario por WhatsApp — a pedido del usuario, un mensaje con el
// total vendido/cantidad de ventas/top productos del día, listo para
// mandar (se abre WhatsApp con el texto ya escrito) apenas pasan las
// 15:30, sin que nadie tenga que acordarse de generarlo a mano. No hay
// envío 100% automático (eso requeriría contratar una API de WhatsApp
// Business, con costo por mensaje) — alguien igual tiene que apretar
// "Enviar" una vez que se abre. "ultimoResumenPreparadoFecha" (YYYY-MM-DD,
// hora local) evita que se vuelva a abrir más de una vez el mismo día.
model ConfiguracionWhatsapp {
  id                         Int      @id @default(autoincrement())
  numeroDueno                String?
  ultimoResumenPreparadoFecha String?
  actualizadoEn              DateTime @updatedAt
}

// Solo puede haber una sesión de caja "abierta" a la vez (una sola persona
// usa el sistema a la vez, según la arquitectura del proyecto).
model SesionCaja {
  id Int @id @default(autoincrement())

  usuarioAperturaId Int
  usuarioApertura   Usuario  @relation("SesionesAbiertasPorUsuario", fields: [usuarioAperturaId], references: [id])
  fondoFijoInicial  Float
  fechaApertura     DateTime @default(now())

  // Sugerido = lo que quedó realmente contado al cerrar la sesión anterior
  // (el fondo "esperado" para empezar el día). Si fondoFijoInicial termina
  // siendo distinto de este valor, es un ajuste manual — motivoAjusteFondo
  // y usuarioAutorizoFondoId quedan solo cuando eso pasa (clave de
  // supervisor + motivo, mismo patrón que las anulaciones de Caja).
  fondoFijoSugerido      Float?
  motivoAjusteFondo      String?
  usuarioAutorizoFondoId Int?
  usuarioAutorizoFondo   Usuario? @relation("SesionesFondoAutorizadoPorUsuario", fields: [usuarioAutorizoFondoId], references: [id])

  estado String @default("abierta") // "abierta" | "cerrada"

  usuarioCierreId Int?
  usuarioCierre   Usuario?  @relation("SesionesCerradasPorUsuario", fields: [usuarioCierreId], references: [id])
  efectivoContado Float?
  fechaCierre     DateTime?

  ventas          Venta[]
  cobrosDeCredito PagoVenta[] @relation("CobrosDeCredito")
  retiros         RetiroCaja[]
}

// Plata que sale o entra físicamente en la caja durante el turno sin ser
// parte de una venta — "retiro" es el caso típico de pagarle en efectivo a
// un proveedor que llega con mercadería a mitad del día; "ingreso" es lo
// contrario (ej. el dueño refuerza el cambio a mitad del día). Ambos se
// suman/restan del efectivo esperado al sacar el reporte X/Z (ver
// calcularResumenSesion) para que no aparezcan como diferencia de caja al
// cerrar. Mismo patrón de autorización que anular una venta: clave de
// supervisor + quién autoriza, para los dos tipos por igual.
//
// El modelo se sigue llamando RetiroCaja (no se renombró a algo genérico
// tipo MovimientoCaja) para no arrastrar un rename de tabla + todas sus
// referencias en el resto del código — "tipo" es lo que distingue un
// ingreso de un retiro real.
model RetiroCaja {
  id Int @id @default(autoincrement())

  sesionCajaId Int
  sesionCaja   SesionCaja @relation(fields: [sesionCajaId], references: [id])

  // "retiro" | "ingreso" — default "retiro" para que las filas ya
  // existentes (todas retiros, de antes de que existiera "ingreso") sigan
  // siendo válidas sin tocarlas.
  tipo   String @default("retiro")
  monto  Float
  motivo String

  usuarioAutorizoId Int
  usuarioAutorizo   Usuario @relation(fields: [usuarioAutorizoId], references: [id])

  fecha DateTime @default(now())
}

// Opciones de corte que se muestran en la web para una familia de producto
// (ej. familia "Vacuno": Bifes, Trozo entero, Medallones, Picada, Molida,
// Parrilla, Otros). Estándar por familia, no por producto individual — se
// asignan a un producto a través de Producto.familiaCorte.
model CorteOpcion {
  id      Int     @id @default(autoincrement())
  familia String
  nombre  String
  orden   Int     @default(0)
  activo  Boolean @default(true)

  @@unique([familia, nombre])
}

// Lista fija de comunas a las que se hace despacho, con su costo de envío
// predefinido (evita que el cajero tenga que escribirlo/tipear la comuna
// cada vez, y permite sacar estadísticas por comuna).
model Comuna {
  id         Int     @id @default(autoincrement())
  nombre     String  @unique
  costoEnvio Float
  activo     Boolean @default(true)

  // Orden manual por cercanía real desde el local (Cerro Navia) para armar
  // la ruta de despacho de forma eficiente — null = todavía no se ordenó
  // esa comuna, queda al final. Se calibra a mano una sola vez (Comunas de
  // despacho), no depende de ninguna API de mapas.
  ordenDespacho Int?

  ventas Venta[]
}

model Venta {
  id Int @id @default(autoincrement())

  sesionCajaId Int
  sesionCaja   SesionCaja @relation(fields: [sesionCajaId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  fecha  DateTime @default(now())
  estado String   @default("abierta") // "abierta" | "pagada" | "anulada"
  total  Float    @default(0)

  // Por defecto "carniceria" (id 1) — toda venta previa a este campo queda
  // asignada ahí. Una venta con ítems de charcutería queda con la unidad de
  // negocio de esos ítems (ver server, se define al vender); hoy con un solo
  // carrito por venta no debería mezclar ambas unidades en la práctica.
  businessUnitId Int          @default(1)
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])

  // Canal por el que se originó la venta — solo informativo para reportes,
  // no cambia ningún cálculo. "local" = mesón, valor por defecto para toda
  // venta hecha directo en caja (incluidas todas las previas a este campo).
  canal String @default("local") // "local" | "online" | "whatsapp" | "corporativo"

  // "Caja auxiliar": normalmente solo hay UNA venta "abierta" a la vez por
  // sesión (ver POST /ventas) — este flag marca las que el cajero abrió
  // aparte, a propósito, para seguir cobrando a otros clientes mientras una
  // venta queda esperando algo (ej. una transferencia que se está
  // confirmando) sin bloquear la caja. Puramente informativo: no cambia
  // ningún cálculo, solo cómo se etiqueta la pestaña en Punto de Venta.
  esAuxiliar Boolean @default(false)

  // Comentario libre y opcional sobre la venta (ej. "cliente pidió sin
  // hueso", "entregar mañana") — se muestra también en el vale impreso.
  comentario String?

  // Despacho (opcional): si la venta se despacha a domicilio, se marca con
  // una comuna de la lista fija — el costo de envío se copia a la venta al
  // elegir la comuna (no cambia después si el costo de esa comuna se
  // actualiza) y se suma al total que paga el cliente.
  esDespacho Boolean @default(false)
  comunaId   Int?
  comuna     Comuna? @relation(fields: [comunaId], references: [id])
  costoEnvio Float?

  // Descuento manual (opcional): aplica sobre el subtotal de los productos,
  // no sobre el costo de envío. "porcentaje" se recalcula solo si el
  // carrito cambia después; "monto_fijo" es un número fijo de pesos.
  descuentoTipo  String? // "porcentaje" | "monto_fijo"
  descuentoValor Float?

  // Si la venta se cancela completa (botón "Cancelar venta", antes de
  // confirmarla) — igual que anular un ítem, deja rastro de quién autorizó.
  usuarioAnulacionId Int?
  usuarioAnulacion   Usuario?  @relation("VentasAnuladasPorUsuario", fields: [usuarioAnulacionId], references: [id])
  motivoAnulacion    String?
  fechaAnulacion     DateTime?

  // Si esta venta se generó desde "Pedidos web" (botón "Enviar a Caja") en
  // vez de armarse a mano en Punto de Venta — permite distinguir "ventas
  // online" del resto en Reportes (mismo total, calculado aparte) y evita
  // mandar el mismo pedido dos veces a Caja.
  origenPedidoWebId Int?       @unique
  origenPedidoWeb   PedidoWeb? @relation(fields: [origenPedidoWebId], references: [id])

  items ItemVenta[]
  pagos PagoVenta[]
}

model ItemVenta {
  id Int @id @default(autoincrement())

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad       Float
  precioUnitario Float // copia del precio al momento de vender — mientras la venta sigue "abierta" SÍ se
  // actualiza en cascada si el precio del producto cambia después (ver actualizarItemsAbiertosPorProducto
  // en server/routes/precios.ts); una vez la venta queda "pagada"/"anulada" ya no se toca, para que quede
  // el registro real de lo que se cobró
  subtotal       Float // ya con el descuento de este ítem aplicado, si tiene uno

  // Solo se llena cuando "producto" es la fila espejo de un SKU de
  // charcutería (ver ItemCharcuteria.productoEspejoId) — de qué lote salió
  // físicamente lo vendido, para trazabilidad y (en una fase futura) FEFO.
  // Null para cualquier venta de carnicería normal.
  loteId Int?
  lote   LoteProduccion? @relation(fields: [loteId], references: [id])

  // Descuento por producto (opcional) — alternativo al descuento de toda la
  // venta (Venta.descuentoTipo): solo puede haber uno de los dos activos a
  // la vez en una misma venta, para que el registro de qué se descontó sea
  // más claro.
  descuentoTipo  String? // "porcentaje" | "monto_fijo"
  descuentoValor Float?

  anulado            Boolean   @default(false)
  usuarioAnulacionId Int?
  usuarioAnulacion   Usuario?  @relation("ItemsAnuladosPorUsuario", fields: [usuarioAnulacionId], references: [id])
  motivoAnulacion    String?
  fechaAnulacion     DateTime?
}

model PagoVenta {
  id Int @id @default(autoincrement())

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id])

  // "credito" y "transferencia" funcionan igual (quedan pendientes hasta
  // marcarse como cobrados, ver más abajo) — se dejaron como dos valores
  // separados, en vez de uno solo, porque el dueño quiere llevarlos como
  // registros aparte (no es lo mismo fiar que esperar que confirme una
  // transferencia), aunque contablemente sean el mismo mecanismo.
  medio String // "efectivo" | "tarjeta" | "credito" | "transferencia"
  monto Float

  // Solo aplica cuando medio = "efectivo": lo que el cliente entregó en la
  // mano (antes del redondeo/tope a lo que se debía) — para poder mostrar
  // en el vale impreso con cuánto pagó y el vuelto correspondiente. null en
  // tarjeta/crédito/transferencia, donde siempre se cobra el monto exacto.
  montoEntregado Float?

  // Solo aplica cuando medio = "credito" o "transferencia": a quién se le
  // fía o se le espera la transferencia, y el registro de cuándo/cómo se
  // cobró después — puede pasar en una sesión de caja distinta a la de la
  // venta original (el cliente vuelve otro día, o la transferencia se
  // confirma más tarde).
  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  // Copia del nombre del cliente al momento de este pago (mismo criterio
  // que ItemVenta.precioUnitario) — así el vale impreso y el historial no
  // dependen de que el registro de Cliente siga existiendo o no haya
  // cambiado de nombre después. clienteId es la relación real; este campo
  // es solo para mostrar.
  clienteNombre     String?
  cobrado           Boolean     @default(false)
  medioCobro        String? // "efectivo" | "tarjeta", cómo pagó al cobrarlo
  sesionCajaCobroId Int?
  sesionCajaCobro   SesionCaja? @relation("CobrosDeCredito", fields: [sesionCajaCobroId], references: [id])
  usuarioCobroId    Int?
  usuarioCobro      Usuario?    @relation("CobrosDeCreditoRegistradosPorUsuario", fields: [usuarioCobroId], references: [id])
  fechaCobro        DateTime?
}

// Registro simple de clientes que compran a crédito o por transferencia —
// antes de esto, cada venta a crédito quedaba con un nombre escrito a mano
// (PagoVenta.clienteNombre), lo que hacía fácil duplicar al mismo cliente
// con el nombre escrito distinto cada vez. Acá el "código" que pidió el
// dueño para identificar al comprador es simplemente el id autoincremental
// (se muestra como "C" + id en pantalla) — no depende de que el cliente se
// sepa un RUT o número de memoria. RUT y teléfono quedan opcionales, solo
// como dato de referencia.
model Cliente {
  id       Int      @id @default(autoincrement())
  nombre   String
  telefono String?
  rut      String?
  notas    String?
  creadoEn DateTime @default(now())

  pagos PagoVenta[]
}

// Copia local de los pedidos armados en la página web (cotización de
// despacho) — se trae mediante el módulo de sync (no se generan acá). No
// reemplaza a Venta ni se liquida contra Producto: es solo el registro de
// lo que el cliente pidió por la web, para que el equipo lo revise y
// coordine, igual que antes se revisaba a mano la planilla de Google
// Sheets. "idWeb" evita duplicar un pedido si el sync se reintenta.
model PedidoWeb {
  id    Int    @id @default(autoincrement())
  idWeb String @unique

  fecha DateTime

  clienteNombre   String
  clienteTelefono String

  // Correlativo que reinicia cada día (el primer pedido que llega hoy es
  // el 1, el segundo el 2, etc.) — para poder decir/anotar "pedido 3" en
  // vez del id interno, que no significa nada para el equipo. Se calcula
  // una sola vez al traerlo por sync (ver traerPedidosWebPendientes) y
  // queda fijo — nunca se recalcula después, así no cambia si otro pedido
  // del mismo día se anula. Null en pedidos sincronizados antes de este
  // campo existir.
  numeroDelDia Int?

  // "retiro" | "despacho" — clienteDireccion/comunaNombre/costoEnvio solo
  // vienen si es despacho (mismo criterio que el modelo Pedido de la web).
  tipoEntrega      String  @default("despacho")
  clienteDireccion String?
  comunaNombre     String?
  costoEnvio       Float?

  fechaEntrega String?
  // Solo informativo — el pago real se coordina aparte, no hay pasarela.
  medioPago    String?

  // JSON con el detalle de productos pedidos (plu, nombre, corte elegido,
  // envasado, instrucciones, cantidad aproximada en kg/unidad, precio
  // unitario al momento de cotizar) — solo para mostrar/calcular el total en
  // pantalla, no hay relación con Producto porque el pedido puede referirse
  // a un catálogo que ya cambió para cuando se revisa (y porque el precio
  // que se muestra es el que el cliente vio al cotizar, no el actual).
  itemsJson String

  comentario String?

  estado String @default("pendiente") // "pendiente" | "atendido" | "anulado"

  atendidoPorId Int?
  atendidoPor   Usuario?  @relation("PedidosWebAtendidosPorUsuario", fields: [atendidoPorId], references: [id])
  atendidoEn    DateTime?

  // Requiere clave de supervisor (igual que anular una venta) — a diferencia
  // de "atendido", que cualquiera puede marcar. motivoAnulacion queda en
  // texto libre (el cliente se arrepintió, pedido duplicado, no contesta,
  // etc.), elegido en el mismo modal que pide la clave.
  motivoAnulacion String?
  anuladoPorId    Int?
  anuladoPor      Usuario?  @relation("PedidosWebAnuladosPorUsuario", fields: [anuladoPorId], references: [id])
  anuladoEn       DateTime?

  // Se aplica sobre el total calculado a partir de itemsJson (cada item ya
  // trae plu + precioUnitario, ver comentario de itemsJson arriba) — no hay
  // un campo "total" acá porque el pedido web sigue siendo una cotización,
  // no una venta: el total con descuento se recalcula al mostrar/imprimir en
  // vez de guardarse aparte, para que quien lo revise en Caja sepa qué
  // aplicar al momento de vender de verdad.
  descuentoTipo   String? // "porcentaje" | "monto"
  descuentoValor  Float?
  descuentoMotivo String?

  // Productos que se incluyeron de regalo (ej. longanizas, hamburguesas) —
  // no le cobran nada al cliente pero sí se descuentan del stock real, a
  // diferencia de itemsJson que es solo texto sin relación a Producto.
  regalos PedidoWebRegalo[]

  // Se llena cuando el equipo manda este pedido a Caja como venta a
  // crédito (botón "Enviar a Caja") — ver Venta.origenPedidoWebId. Null
  // mientras el pedido siga sin cobrarse en Caja.
  ventaGenerada Venta?

  sincronizadoEn DateTime @default(now())
}

// Producto real (no solo texto) agregado de regalo a un pedido web — a
// diferencia de itemsJson (lo que pidió el cliente, sin costo cero posible
// ni relación a Producto), esto sí descuenta stock de verdad apenas se
// agrega, independiente de si el pedido después se manda o no a Caja: es
// una merma real del negocio, no algo que dependa de cobrarse.
model PedidoWebRegalo {
  id Int @id @default(autoincrement())

  pedidoWebId Int
  pedidoWeb   PedidoWeb @relation(fields: [pedidoWebId], references: [id])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  // Mismo criterio de unidad que ItemVenta.cantidad (kg para pesable,
  // unidades para el resto) — a diferencia de itemsJson, que guarda
  // gramos: acá lo entra el equipo directo en el POS, no viene del
  // carrito de la web.
  cantidad Float

  agregadoPorId Int
  agregadoPor   Usuario  @relation(fields: [agregadoPorId], references: [id])
  agregadoEn    DateTime @default(now())
}

// --- Módulo de Cámara Frigorífica ---
// Cada caja física en la cámara tiene identidad propia (no es solo un
// número de stock agregado como en MovimientoInventario/Producto.stockActual
// — eso sigue siendo el stock de "sala de venta"). La cámara es una zona de
// almacenamiento aparte: una caja entra a cámara, y solo cuando sale hacia
// "Sala de venta" es cuando corresponde generar un MovimientoInventario que
// aumente el stock vendible (Producto.stockActual) — igual que cualquier
// otra entrada. Ver server/routes/camara.ts para la lógica de cada flujo.

// Agrupa las cajas que se ingresaron juntas en una misma entrada (mismo
// producto, familia, peso total y costo neto) — para poder corregir,
// reimprimir o anular todas sus cajas de una vez, igual que el sistema que
// ya usaba el papá del usuario antes de este. Las cajas siguen siendo el
// registro real de stock (CajaCamara); el lote es solo el "grupo" al que
// pertenecen, y por sí solo no tiene saldo ni movimientos propios.
model LoteCamara {
  id Int @id @default(autoincrement())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  familiaNombre String // Vacuno | Cerdo | Pollo | Otros

  // Solo aplica (y es obligatorio) para familia "Vacuno" — de dónde viene
  // la carne: Nacional, Brasil o Paraguay. Null para las demás familias.
  procedencia String?

  cantidadCajas Int
  pesoTotalKg   Float
  costoNetoKg   Float
  totalNeto     Float // round(pesoTotalKg * costoNetoKg)

  // Factura de compra que originó este lote — opcionales porque los lotes
  // ya existentes (y los reconstruidos, ver más abajo) no la tienen.
  proveedorId   Int?
  proveedor     Proveedor? @relation(fields: [proveedorId], references: [id])
  numeroFactura String?

  fechaIngreso DateTime @default(now())

  creadoPorId Int
  creadoPor   Usuario @relation(fields: [creadoPorId], references: [id])

  // Verdadero para lotes armados automáticamente al agrupar cajas que ya
  // existían antes de que este modelo se agregara — informativo, no cambia
  // ningún comportamiento (ver server/lib/migraciones.ts).
  reconstruido Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  cajas        CajaCamara[]
  correcciones CorreccionLoteCamara[]
}

// Historial de correcciones a un lote — nunca se sobrescribe el lote sin
// dejar rastro, se agrega un registro nuevo por cada corrección (mismo
// principio que HistorialPrecio para productos).
model CorreccionLoteCamara {
  id Int @id @default(autoincrement())

  loteId Int
  lote   LoteCamara @relation(fields: [loteId], references: [id])

  familiaAnterior     String
  procedenciaAnterior String?
  productoAnterior    String // nombre del producto al momento de corregir, no un id — es solo un dato histórico para mostrar
  pesoTotalAnteriorKg Float
  costoAnteriorKg     Float

  familiaNueva     String
  procedenciaNueva String?
  productoNuevo    String
  pesoTotalNuevoKg Float
  costoNuevoKg     Float

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now())
}

// El número de caja de 6 dígitos que se imprime en la etiqueta se deriva
// del id (ej. id 28 → "000028") en el código de la aplicación, no se guarda
// aparte — id ya es único, inmutable y lo asigna la base de datos sola
// (nunca se calcula el próximo número en el navegador).
model CajaCamara {
  id Int @id @default(autoincrement())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  // El lote agrupa las cajas que se ingresaron juntas en una misma entrada
  // (mismo producto, familia, peso total y costo) — permite corregir,
  // reimprimir o anular todas sus cajas de una vez. Opcional solo por las
  // cajas que ya existían antes de que este campo se agregara (se les
  // reconstruye un lote propio automáticamente al iniciar el programa, ver
  // server/lib/migraciones.ts) — toda caja nueva siempre tiene lote.
  loteId Int?
  lote   LoteCamara? @relation(fields: [loteId], references: [id])

  // Familia fija elegida a mano al ingresar (Vacuno/Cerdo/Pollo/Otros) —
  // antes se sacaba sola de la categoría del producto; se guarda igual en
  // este campo para no duplicar la idea de "instantánea que no cambia si
  // el producto se recategoriza después".
  familiaNombre String

  // Solo aplica (y es obligatorio) para familia "Vacuno": Nacional, Brasil
  // o Paraguay — para saber de dónde viene esa carne. Null en las demás
  // familias.
  procedencia String?

  fechaIngreso  DateTime @default(now())
  pesoInicialKg Float
  saldoKg       Float
  costoNetoKg   Float

  // "en_camara" | "parcial" | "salida" | "ajuste_pendiente" | "anulada"
  estado String @default("en_camara")

  // Verdadero si el peso se repartió desde un total de lote (ej. factura
  // con 10 cajas y 225kg totales → 22,5kg estimados por caja) — se puede
  // corregir después con un ajuste auditado (MovimientoCamara).
  pesoEstimado Boolean @default(false)

  creadoPorId Int
  creadoPor   Usuario @relation(fields: [creadoPorId], references: [id])

  // Control de concurrencia optimista: cada operación que modifica el saldo
  // debe conocer la versión actual y la incrementa — si otra operación ya
  // la cambió mientras tanto, se rechaza en vez de pisar el cambio ajeno
  // (dos operadores no pueden descontar la misma caja al mismo tiempo).
  version Int @default(1)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  movimientos       MovimientoCamara[]
  esperados         InventarioCamaraEsperado[]
  escaneos          EscaneoInventarioCamara[]
  salidasMayoristas SalidaMayorista[]
}

// Cada cambio a una caja es un movimiento inmutable — nunca se reemplaza el
// historial editando solo el saldo de la caja (mismo principio que ya usa
// MovimientoInventario para el stock general).
model MovimientoCamara {
  id Int @id @default(autoincrement())

  cajaId Int
  caja   CajaCamara @relation(fields: [cajaId], references: [id])

  // "entrada" | "salida_parcial" | "salida_completa" | "transferencia" |
  // "consumo_produccion" | "merma" | "donacion" | "ajuste_entrada" | "ajuste_salida"
  tipo String

  pesoKg Float // siempre positivo — el signo lo da el tipo

  // "camara" | "sala_venta" | "mayorista" | "produccion" | "merma" | "donacion" | "otro"
  origen  String?
  destino String?

  motivo String?

  // Relación opcional con otro registro del sistema que originó este
  // movimiento (ej. "mayorista" + id de SalidaMayorista).
  referenciaTipo String?
  referenciaId   Int?

  usuarioId   Int
  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  dispositivo String? // descripción del origen (ej. "Celular Marco", "PC principal")

  // Evita que un reintento (ej. celular sin conexión que reintenta solo al
  // recuperar señal) duplique el movimiento — igual que el sistema ya
  // rechaza una segunda salida completa de la misma caja.
  claveIdempotencia String @unique

  creadoEn DateTime @default(now())
}

// Cada sesión de inventario por escaneo agrupa una revisión completa de la
// cámara — solo puede haber una abierta a la vez (mismo patrón que SesionCaja).
model SesionInventarioCamara {
  id Int @id @default(autoincrement())

  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?

  iniciadoPorId Int
  iniciadoPor   Usuario @relation("SesionesCamaraIniciadasPorUsuario", fields: [iniciadoPorId], references: [id])

  finalizadoPorId Int?
  finalizadoPor   Usuario? @relation("SesionesCamaraFinalizadasPorUsuario", fields: [finalizadoPorId], references: [id])

  // "abierta" | "finalizada" | "conciliada"
  estado        String  @default("abierta")
  observaciones String?

  esperados InventarioCamaraEsperado[]
  escaneos  EscaneoInventarioCamara[]
}

// Instantánea de todas las cajas con saldo positivo al momento de ABRIR la
// sesión de inventario — indispensable para no generar falsos faltantes si
// entra o sale una caja mientras el conteo está en curso.
model InventarioCamaraEsperado {
  id Int @id @default(autoincrement())

  sesionId Int
  sesion   SesionInventarioCamara @relation(fields: [sesionId], references: [id])

  cajaId Int
  caja   CajaCamara @relation(fields: [cajaId], references: [id])

  saldoEsperadoKg Float
  estadoEsperado  String
  capturadoEn     DateTime @default(now())

  @@unique([sesionId, cajaId])
}

// Un escaneo por sesión y caja — el índice único evita que un doble escaneo
// (ej. el operador pasa la pistola dos veces sin querer) duplique el conteo.
model EscaneoInventarioCamara {
  id Int @id @default(autoincrement())

  sesionId Int
  sesion   SesionInventarioCamara @relation(fields: [sesionId], references: [id])

  cajaId Int
  caja   CajaCamara @relation(fields: [cajaId], references: [id])

  escaneadoEn DateTime @default(now())

  escaneadoPorId Int
  escaneadoPor   Usuario @relation(fields: [escaneadoPorId], references: [id])
  dispositivo    String?

  estadoAlEscanear  String
  saldoAlEscanearKg Float

  @@unique([sesionId, cajaId])
}

// Salida de cámara hacia un cliente mayorista — registro simple y propio
// (no pasa por toda la lógica de Caja con sesión abierta/medios de pago),
// pensado solo para llevar el rastro de cantidad, precio y si ya se cobró.
model SalidaMayorista {
  id Int @id @default(autoincrement())

  fecha DateTime @default(now())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidadKg  Float
  precioTotal Float

  // "pagado" | "pendiente"
  estadoPago String @default("pendiente")

  clienteNombre String?

  cajaCamaraId Int?
  cajaCamara   CajaCamara? @relation(fields: [cajaCamaraId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  observaciones String?

  // Anular una venta al por mayor ya registrada (ej. se ingresó mal, o el
  // cliente se arrepintió) — solo se puede si la caja de cámara de origen
  // no tuvo ningún movimiento después de esta venta, mismo principio que
  // "Anular una entrada" de cámara. Se guarda el registro igual que
  // cualquier otra anulación del sistema (usuario, motivo, fecha) en vez
  // de borrar la fila.
  anulada            Boolean   @default(false)
  usuarioAnulacionId Int?
  usuarioAnulacion   Usuario?  @relation("SalidasMayoristasAnuladasPorUsuario", fields: [usuarioAnulacionId], references: [id])
  motivoAnulacion    String?
  fechaAnulacion     DateTime?
}

// --- Módulo Charcutería ---
// Submarca de charcutería y ahumados artesanales, bajo la misma razón
// social que la carnicería pero con gestión propia (costos, márgenes,
// stock, trazabilidad separados). Ver informe de Fase 0 / CLAUDE.md para el
// contexto completo de negocio y las decisiones de diseño.

// Unidad de negocio (centro de costo). Se siembra con exactamente 2 filas
// de id fijo (1 = carniceria, 2 = charcuteria, ver migración de datos) —
// todo registro que ya existía antes de este modelo queda en "carniceria"
// por el default de cada businessUnitId nuevo, sin tocar ninguna fila a
// mano.
model BusinessUnit {
  id     Int     @id @default(autoincrement())
  codigo String  @unique // "carniceria" | "charcuteria"
  nombre String
  activo Boolean @default(true)

  creadoEn DateTime @default(now())

  productos             Producto[]
  movimientosInventario MovimientoInventario[]
  ventas                Venta[]
  itemsCharcuteria      ItemCharcuteria[]
}

// Catálogo propio de charcutería, PARALELO a Producto (decisión explícita:
// separación de gestión real, no solo un filtro sobre el mismo catálogo).
// Cubre desde materia prima interna hasta el SKU final — "tipoItem"
// distingue cada uno, mismo criterio de string-en-vez-de-enum que el resto
// del repo usa para SQLite (ej. Producto.flagBalanza).
//
// Solo "producto_terminado" (el SKU que de verdad se vende) tiene además
// una fila espejo en Producto (productoEspejoId): así se vende por el flujo
// de Caja existente sin tocarlo. Los demás tipos nunca se venden directo y
// no tienen espejo.
model ItemCharcuteria {
  id     Int    @id @default(autoincrement())
  codigo String @unique
  nombre String

  tipoItem String // "materia_prima" | "insumo" | "envase_etiqueta" | "producto_elaborado" | "producto_terminado"

  businessUnitId Int          @default(2)
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])

  // Gramos si se mide por peso, unidades si no (envases, etiquetas, o un
  // producto_terminado vendido en formato fijo) — un solo campo, igual
  // criterio que ItemVenta.cantidad (kg vs. unidades según el producto).
  unidadMedida String @default("gramos") // "gramos" | "unidad"

  // Saldo agregado — NO aplica a producto_terminado (ese stock se trackea
  // por lote, ver StockLoteSku, porque necesita vencimiento y FEFO a nivel
  // de lote individual, no un solo número agregado). Queda en 0 sin usar
  // para esos casos.
  stockActual Float @default(0)

  // --- Solo aplica a producto_terminado ---
  // Gramos netos del formato envasado — null si este SKU se vende a granel
  // (por peso), igual que Producto con flagBalanza=PESABLE en su espejo.
  formatoGramos Int?

  productoElaboradoId Int?
  productoElaborado   ItemCharcuteria?  @relation("ProductoElaboradoDeSku", fields: [productoElaboradoId], references: [id])
  skusDelElaborado    ItemCharcuteria[] @relation("ProductoElaboradoDeSku")

  productoEspejoId Int?      @unique
  productoEspejo   Producto? @relation(fields: [productoEspejoId], references: [id])

  linea String? // "tabla" | "fiestas"

  // Costo de referencia (última compra/transferencia) — igual criterio que
  // Producto.costoReferencia: informativo, nunca reemplaza el costeo real
  // de un lote (ver LoteProduccion.costoTotal).
  costoReferencia Float?

  // --- Rotulado (solo producto_elaborado) ---
  ingredientes            String?
  alergenos               String?
  condicionesConservacion String?
  vidaUtilDias            Int?
  sellosAltoEnTexto       String? // texto libre, sin cálculo automático (fuera de alcance)

  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  creadoPorId   Int
  creadoPor     Usuario  @relation(fields: [creadoPorId], references: [id])

  recetas               Receta[]
  recetaIngredientes    RecetaIngrediente[]
  preciosTransferencia  PrecioTransferencia[]
  transferenciasRecibidas TransferenciaInterna[]
  movimientos           MovimientoCharcuteria[]
  loteInsumosConsumidos LoteInsumoConsumido[]
  envasadosComoSku      Envasado[]             @relation("SkuEnvasado")
  envasadosComoEnvase   Envasado[]             @relation("EnvaseUsadoEnEnvasado")
  envasadosComoEtiqueta Envasado[]             @relation("EtiquetaUsadaEnEnvasado")
  stockPorLote          StockLoteSku[]         @relation("SkuStock")
}

// Ledger de movimientos de materia_prima/insumo/envase_etiqueta — mismo
// patrón que MovimientoInventario (cantidad siempre positiva, el signo lo
// da "tipo"). No aplica a producto_terminado (ver Envasado/StockLoteSku).
model MovimientoCharcuteria {
  id Int @id @default(autoincrement())

  itemId Int
  item   ItemCharcuteria @relation(fields: [itemId], references: [id])

  tipo   String // "entrada" | "salida"
  motivo String // entrada: "transferencia" | "compra" | "ajuste" — salida: "consumo_lote" | "merma" | "ajuste"

  cantidad Float // mismas unidades que ItemCharcuteria.unidadMedida

  // Referencia opcional a qué originó el movimiento (ej. "transferencia" +
  // id de TransferenciaInterna, o "lote" + id de LoteProduccion).
  referenciaTipo String?
  referenciaId   Int?

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  fecha DateTime @default(now())
}

// Ficha técnica versionada de un producto_elaborado. Solo una versión
// "activa" por producto elaborado a la vez (se aplica en el server, dentro
// de una transacción — SQLite/Prisma no tiene índice único parcial para
// forzarlo a nivel de base de datos). Las versiones anteriores quedan de
// solo lectura; cada lote guarda qué versión usó (LoteProduccion.recetaVersion).
model Receta {
  id Int @id @default(autoincrement())

  productoElaboradoId Int
  productoElaborado   ItemCharcuteria @relation(fields: [productoElaboradoId], references: [id])

  version Int
  activa  Boolean @default(true)

  rendimientoEsperadoPct  Float // % de kg de salida esperados sobre kg de entrada
  dosisSalesCurantesPorKg Float?

  // JSON/texto libre a propósito: temperatura y tiempo de ahumado/cocción,
  // curado, reposo — cada receta puede necesitar parámetros distintos, no
  // conviene forzar columnas fijas para esto.
  parametrosProceso String?
  notas             String?

  creadoPorId Int
  creadoPor   Usuario  @relation(fields: [creadoPorId], references: [id])
  creadoEn    DateTime @default(now())

  ingredientes RecetaIngrediente[]
  lotes        LoteProduccion[]

  @@unique([productoElaboradoId, version])
}

model RecetaIngrediente {
  id Int @id @default(autoincrement())

  recetaId Int
  receta   Receta @relation(fields: [recetaId], references: [id])

  itemId Int
  item   ItemCharcuteria @relation(fields: [itemId], references: [id])

  cantidadPorLoteBase Float
  unidad              String // "gramos" | "unidad" — mismo criterio que ItemCharcuteria.unidadMedida
}

// Historial de precio de transferencia por ítem — nunca se edita una fila,
// se agrega una nueva y la última vigente (mayor "vigenteDesde") manda,
// mismo patrón que HistorialPrecio. Nunca puede ser 0 (se valida en el
// server, ver informe de Fase 0 pregunta 7: si no hay precio de venta del
// que partir, se usa el costo de referencia/compra del ítem, y si tampoco
// hay ninguno, se exige ingresarlo a mano).
model PrecioTransferencia {
  id Int @id @default(autoincrement())

  itemId Int
  item   ItemCharcuteria @relation(fields: [itemId], references: [id])

  precioPorKgOUnidad Float
  vigenteDesde       DateTime @default(now())

  creadoPorId Int
  creadoPor   Usuario @relation(fields: [creadoPorId], references: [id])

  transferencias TransferenciaInterna[]
}

// Materia prima de carnicería (Producto) que pasa a charcutería
// (ItemCharcuteria) — descuenta MovimientoInventario en carnicería y suma
// MovimientoCharcuteria en charcutería (ver server). El precio se copia al
// momento (precioPorKg) aunque el histórico de PrecioTransferencia cambie
// después, para que el registro de lo transferido no se altere solo.
model TransferenciaInterna {
  id Int @id @default(autoincrement())

  productoOrigenId Int
  productoOrigen   Producto @relation(fields: [productoOrigenId], references: [id])

  itemDestinoId Int
  itemDestino   ItemCharcuteria @relation(fields: [itemDestinoId], references: [id])

  cantidad Float // kg

  precioTransferenciaId Int
  precioTransferencia   PrecioTransferencia @relation(fields: [precioTransferenciaId], references: [id])
  precioPorKg           Float

  fecha         DateTime @default(now())
  responsableId Int
  responsable   Usuario  @relation(fields: [responsableId], references: [id])
}

// Lote de producción — mismo patrón que LoteCamara/CajaCamara (cabecera +
// movimientos/registro asociado), adaptado a un proceso de elaboración en
// vez de solo almacenamiento en frío.
model LoteProduccion {
  id     Int    @id @default(autoincrement())
  codigo String @unique // "CH-AAMMDD-NN", NN reinicia cada día (ver server)

  recetaId      Int
  receta        Receta @relation(fields: [recetaId], references: [id])
  recetaVersion Int // copiado de receta.version al crear el lote — no cambia si la receta cambia de versión activa después

  estado String @default("en_proceso") // "en_proceso" | "terminado" | "envasado" | "cerrado" | "anulado"

  fechaElaboracion DateTime @default(now())
  responsableId    Int
  responsable      Usuario  @relation("LotesProduccionResponsable", fields: [responsableId], references: [id])

  pesoEntradaKg Float?
  pesoSalidaKg  Float?
  // Calculados en el server a partir de los pesos reales — nunca editables
  // a mano directo.
  mermaEsperadaPct Float? // copiado de receta.rendimientoEsperadoPct al crear el lote
  mermaRealPct     Float?

  horasManoObra     Float?
  costoHoraManoObra Float?

  // JSON/texto libre, mismo criterio que Receta.parametrosProceso —
  // parámetros REALES del proceso (vs. los esperados de la receta).
  parametrosRealesProceso String?

  // = fechaElaboracion + receta.vidaUtilDias al crear el lote. Editable
  // después solo por admin — el valor actual vive acá; cada cambio queda
  // en LoteVencimientoCambio (nunca se sobrescribe en silencio).
  fechaVencimiento DateTime?

  otrosCostosManuales Float? // otros costos del lote no cubiertos por materia prima/insumos/mano de obra/envase
  // Costo total calculado (materia prima a precio de transferencia +
  // insumos + mano de obra imputada + envases/etiquetas + otrosCostosManuales)
  // — se recalcula en el server, nunca editable a mano directo.
  costoTotal Float?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  insumosConsumidos  LoteInsumoConsumido[]
  envasados          Envasado[]
  stockPorSku        StockLoteSku[]
  itemsVenta         ItemVenta[]
  cambiosVencimiento LoteVencimientoCambio[]
}

// Cada cambio a la fecha de vencimiento de un lote queda como registro
// nuevo (nunca se pisa el anterior) — mismo principio que
// CorreccionLoteCamara para lotes de cámara.
model LoteVencimientoCambio {
  id Int @id @default(autoincrement())

  loteId Int
  lote   LoteProduccion @relation(fields: [loteId], references: [id])

  vencimientoAnterior DateTime?
  vencimientoNuevo    DateTime
  motivo              String

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now())
}

// Insumo/materia prima efectivamente consumido por un lote, con su costo
// real al momento (nunca cambia después, aunque el costo de referencia del
// ítem cambie) — es lo que arma el costeo real del lote.
model LoteInsumoConsumido {
  id Int @id @default(autoincrement())

  loteId Int
  lote   LoteProduccion @relation(fields: [loteId], references: [id])

  itemId Int
  item   ItemCharcuteria @relation(fields: [itemId], references: [id])

  cantidad Float // mismas unidades que ItemCharcuteria.unidadMedida

  origenTipo String // "transferencia" | "compra"
  origenId   Int? // id de TransferenciaInterna o MovimientoCharcuteria, según origenTipo

  costoUnitarioAlMomento Float
}

// Fracciona el stock a granel de un lote en N unidades de un SKU —
// descuenta granel (LoteProduccion.pesoSalidaKg efectivo, vía el registro
// del propio Envasado) y envases/etiquetas (MovimientoCharcuteria), y suma
// stock de producto_terminado del lote (StockLoteSku).
model Envasado {
  id Int @id @default(autoincrement())

  loteId Int
  lote   LoteProduccion @relation(fields: [loteId], references: [id])

  skuId Int
  sku   ItemCharcuteria @relation("SkuEnvasado", fields: [skuId], references: [id])

  cantidadUnidadesGeneradas Int
  pesoNetoPorUnidadG        Int
  pesoRealTotalUsadoG       Int
  // = pesoRealTotalUsadoG - (cantidadUnidadesGeneradas * pesoNetoPorUnidadG) — calculado en el server.
  diferenciaPesoG Int

  envaseItemId      Int?
  envaseItem        ItemCharcuteria? @relation("EnvaseUsadoEnEnvasado", fields: [envaseItemId], references: [id])
  envasesConsumidos Int?

  etiquetaItemId      Int?
  etiquetaItem        ItemCharcuteria? @relation("EtiquetaUsadaEnEnvasado", fields: [etiquetaItemId], references: [id])
  etiquetasConsumidas Int?

  fecha         DateTime @default(now())
  responsableId Int
  responsable   Usuario  @relation(fields: [responsableId], references: [id])
}

// Saldo de producto_terminado POR LOTE — necesario para vencimiento y (en
// una fase futura) FEFO. A diferencia de ItemCharcuteria.stockActual (que
// no aplica a producto_terminado), este es el stock real vendible: cada
// combinación lote+SKU tiene su propio saldo y hereda el vencimiento del
// lote al crearse (no se vuelve a copiar acá, para no desincronizar si el
// lote se corrige — se consulta vía lote.fechaVencimiento).
model StockLoteSku {
  id Int @id @default(autoincrement())

  loteId Int
  lote   LoteProduccion @relation(fields: [loteId], references: [id])

  skuId Int
  sku   ItemCharcuteria @relation("SkuStock", fields: [skuId], references: [id])

  saldoUnidades Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([loteId, skuId])
}

// Umbral de "por vencer" para las alertas de charcutería (Avisos) — siempre
// hay como máximo una fila, mismo patrón que ConfiguracionBalanza.
model ConfiguracionCharcuteria {
  id                    Int @id @default(autoincrement())
  umbralVencimientoDias Int @default(7)
}
