// Esquema de datos del módulo "Gestión de precios".
// Ver /CLAUDE.md para el contexto de negocio detrás de cada campo.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" para poder seguir desarrollando en este entorno Linux;
  // "windows" para que el motor de Prisma quede incluido en el instalador
  // que corre en el PC de la carnicería.
  binaryTargets = ["native", "windows"]
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  cambiosPrecio         HistorialPrecio[]
  movimientosInventario MovimientoInventario[]

  sesionesAbiertas           SesionCaja[] @relation("SesionesAbiertasPorUsuario")
  sesionesCerradas           SesionCaja[] @relation("SesionesCerradasPorUsuario")
  sesionesFondoAutorizado    SesionCaja[] @relation("SesionesFondoAutorizadoPorUsuario")
  ventas                     Venta[]
  ventasAnuladas             Venta[]      @relation("VentasAnuladasPorUsuario")
  itemsAnulados              ItemVenta[]  @relation("ItemsAnuladosPorUsuario")
  cobrosDeCreditoRegistrados PagoVenta[]  @relation("CobrosDeCreditoRegistradosPorUsuario")
  gastos                     Gasto[]

  cajasCamaraCreadas          CajaCamara[]
  lotesCamaraCreados          LoteCamara[]
  correccionesLoteCamara      CorreccionLoteCamara[]
  movimientosCamara           MovimientoCamara[]
  sesionesCamaraIniciadas     SesionInventarioCamara[]  @relation("SesionesCamaraIniciadasPorUsuario")
  sesionesCamaraFinalizadas   SesionInventarioCamara[]  @relation("SesionesCamaraFinalizadasPorUsuario")
  escaneosCamara              EscaneoInventarioCamara[]
  salidasMayoristaRegistradas SalidaMayorista[]
  salidasMayoristaAnuladas    SalidaMayorista[] @relation("SalidasMayoristasAnuladasPorUsuario")
}

// Gastos generales del negocio (sueldos, luz, agua, arriendo, etc.) —
// separado de las compras de mercadería, que ya se registran como entradas
// de inventario (con su propio proveedor/costo).
model Gasto {
  id Int @id @default(autoincrement())

  fecha       DateTime @default(now())
  categoria   String // ej. "Sueldos", "Luz", "Agua", "Arriendo", "Otros"
  descripcion String?
  monto       Float

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

// Categorías jerárquicas de 3 niveles, ej: 01 Aves > 0101 Pollos > 010101 Trutros.
model Categoria {
  id     Int    @id @default(autoincrement())
  codigo String @unique
  nombre String
  nivel  Int

  padreId Int?
  padre   Categoria?  @relation("CategoriaJerarquia", fields: [padreId], references: [id])
  hijos   Categoria[] @relation("CategoriaJerarquia")

  productos Producto[]
}

// SQLite no soporta enums nativos en Prisma; el valor permitido
// ("NORMAL" | "PESABLE" | "IMPORTE") se valida en la capa de API (zod).
model Producto {
  id          Int     @id @default(autoincrement())
  plu         String  @unique
  descripcion String
  nombreCorto String?
  marca       String?

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  // Precio por kg si flagBalanza es PESABLE/IMPORTE, precio por unidad si es NORMAL.
  precio Float

  // Precio de venta al por mayor (opcional) — de referencia, editable
  // directo (a diferencia de "precio", no pasa por el historial de
  // cambios de precio). No reemplaza el precio que se negocia en cada
  // "Venta por mayor" de Cámara — es solo un valor guardado para
  // consultarlo rápido al armar una factura o cotizar.
  precioMayor Float?

  flagBalanza String @default("NORMAL")

  // Solo aplica cuando flagBalanza = NORMAL: la balanza imprime su propio
  // código con peso/precio embebido para productos pesables/importe.
  codigoBarras String? @unique

  contenido         String?
  capacidadPorCaja  String?
  envase            String?
  impuestoAdicional Float?  @default(0)
  duracion          String?
  codigoProveedor   String?

  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Se actualiza solo con cada movimiento de inventario (entrada/salida);
  // no se edita a mano desde la ficha del producto.
  stockActual     Float  @default(0)
  umbralStockBajo Float?

  historialPrecio       HistorialPrecio[]
  movimientosInventario MovimientoInventario[]
  itemsVenta            ItemVenta[]

  cajasCamara       CajaCamara[]
  lotesCamara       LoteCamara[]
  salidasMayoristas SalidaMayorista[]
}

model HistorialPrecio {
  id Int @id @default(autoincrement())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  precioAnterior Float
  precioNuevo    Float
  tipoCambio     String // "individual" | "individual_caja" | "masivo_categoria" | "masivo_csv"

  // Solo se llena para "individual_caja" (cambio rápido de precio hecho
  // desde Punto de venta, que pide clave de supervisor) — el resto de los
  // tipos de cambio nunca la piden, así que queda null.
  motivoAutorizacion String?

  fecha DateTime @default(now())
}

model Proveedor {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique
  contacto String?
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  movimientos MovimientoInventario[]
  lotesCamara LoteCamara[]
}

// "Entrada" siempre suma stock (compra a proveedor, o ajuste positivo por
// conteo físico sin proveedor). "Salida" siempre resta stock (venta,
// descarte/merma, o ajuste negativo). La cantidad siempre se guarda positiva;
// el signo lo da el campo tipo.
model MovimientoInventario {
  id Int @id @default(autoincrement())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo   String // "entrada" | "salida"
  motivo String // entrada: "compra" | "ajuste" — salida: "venta" | "descarte" | "ajuste"

  cantidad Float

  // Solo aplica a entradas por compra.
  costoUnitario Float?
  proveedorId   Int?
  proveedor     Proveedor? @relation(fields: [proveedorId], references: [id])
  numeroFactura String?

  fecha DateTime @default(now())
}

// Clave única compartida entre supervisores (no hay cuentas/contraseñas por
// persona en este sistema). Siempre hay como máximo una fila; se sobrescribe
// al cambiarla. Se guarda hasheada, nunca en texto plano.
model ClaveSupervisor {
  id            Int      @id @default(autoincrement())
  hashClave     String
  actualizadoEn DateTime @updatedAt
}

// Configuración del asistente de IA. Guarda la clave de API de Anthropic tal
// cual (no hasheada, a diferencia de ClaveSupervisor) porque hay que poder
// volver a leerla para llamar a la API — no es una clave que solo se verifica
// por comparación. Vive en el mismo archivo local que el resto de los datos
// del negocio, en el PC de la carnicería; nunca se sube a git ni se muestra
// de vuelta al frontend una vez guardada. Siempre hay como máximo una fila.
model ConfiguracionIA {
  id                Int      @id @default(autoincrement())
  claveApiAnthropic String
  actualizadoEn     DateTime @updatedAt
}

// Direcciones IP de las balanzas (son espejo entre sí: se les manda el mismo
// catálogo a las dos). Puerto 3001 confirmado por captura de red real.
// Siempre hay como máximo una fila.
model ConfiguracionBalanza {
  id            Int      @id @default(autoincrement())
  ip1           String   @default("192.168.18.122")
  ip2           String   @default("192.168.18.120")
  puerto        Int      @default(3001)
  actualizadoEn DateTime @updatedAt
}

// Configuración y estado del respaldo automático de la base de datos — a
// pedido del usuario, para no depender de copiar el archivo a mano. El
// respaldo "local" (carpeta aparte en el mismo PC) siempre está activo; el
// respaldo a USB es opcional y solo se intenta si hay una ruta configurada
// Y ese USB está conectado en el momento (si no lo está, no es un error,
// simplemente ese respaldo puntual queda pendiente para la próxima vez).
// Siempre hay como máximo una fila (mismo patrón que ConfiguracionBalanza).
model ConfiguracionRespaldo {
  id      Int     @id @default(autoincrement())
  rutaUsb String?

  ultimoLocalEn    DateTime?
  ultimoLocalOk    Boolean?
  ultimoLocalError String?

  ultimoUsbEn    DateTime?
  ultimoUsbOk    Boolean?
  ultimoUsbError String?

  actualizadoEn DateTime @updatedAt
}

// Solo puede haber una sesión de caja "abierta" a la vez (una sola persona
// usa el sistema a la vez, según la arquitectura del proyecto).
model SesionCaja {
  id Int @id @default(autoincrement())

  usuarioAperturaId Int
  usuarioApertura   Usuario  @relation("SesionesAbiertasPorUsuario", fields: [usuarioAperturaId], references: [id])
  fondoFijoInicial  Float
  fechaApertura     DateTime @default(now())

  // Sugerido = lo que quedó realmente contado al cerrar la sesión anterior
  // (el fondo "esperado" para empezar el día). Si fondoFijoInicial termina
  // siendo distinto de este valor, es un ajuste manual — motivoAjusteFondo
  // y usuarioAutorizoFondoId quedan solo cuando eso pasa (clave de
  // supervisor + motivo, mismo patrón que las anulaciones de Caja).
  fondoFijoSugerido      Float?
  motivoAjusteFondo      String?
  usuarioAutorizoFondoId Int?
  usuarioAutorizoFondo   Usuario? @relation("SesionesFondoAutorizadoPorUsuario", fields: [usuarioAutorizoFondoId], references: [id])

  estado String @default("abierta") // "abierta" | "cerrada"

  usuarioCierreId Int?
  usuarioCierre   Usuario?  @relation("SesionesCerradasPorUsuario", fields: [usuarioCierreId], references: [id])
  efectivoContado Float?
  fechaCierre     DateTime?

  ventas          Venta[]
  cobrosDeCredito PagoVenta[] @relation("CobrosDeCredito")
}

// Lista fija de comunas a las que se hace despacho, con su costo de envío
// predefinido (evita que el cajero tenga que escribirlo/tipear la comuna
// cada vez, y permite sacar estadísticas por comuna).
model Comuna {
  id         Int     @id @default(autoincrement())
  nombre     String  @unique
  costoEnvio Float
  activo     Boolean @default(true)

  ventas Venta[]
}

model Venta {
  id Int @id @default(autoincrement())

  sesionCajaId Int
  sesionCaja   SesionCaja @relation(fields: [sesionCajaId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  fecha  DateTime @default(now())
  estado String   @default("abierta") // "abierta" | "pagada" | "anulada"
  total  Float    @default(0)

  // Comentario libre y opcional sobre la venta (ej. "cliente pidió sin
  // hueso", "entregar mañana") — se muestra también en el vale impreso.
  comentario String?

  // Despacho (opcional): si la venta se despacha a domicilio, se marca con
  // una comuna de la lista fija — el costo de envío se copia a la venta al
  // elegir la comuna (no cambia después si el costo de esa comuna se
  // actualiza) y se suma al total que paga el cliente.
  esDespacho Boolean @default(false)
  comunaId   Int?
  comuna     Comuna? @relation(fields: [comunaId], references: [id])
  costoEnvio Float?

  // Descuento manual (opcional): aplica sobre el subtotal de los productos,
  // no sobre el costo de envío. "porcentaje" se recalcula solo si el
  // carrito cambia después; "monto_fijo" es un número fijo de pesos.
  descuentoTipo  String? // "porcentaje" | "monto_fijo"
  descuentoValor Float?

  // Si la venta se cancela completa (botón "Cancelar venta", antes de
  // confirmarla) — igual que anular un ítem, deja rastro de quién autorizó.
  usuarioAnulacionId Int?
  usuarioAnulacion   Usuario?  @relation("VentasAnuladasPorUsuario", fields: [usuarioAnulacionId], references: [id])
  motivoAnulacion    String?
  fechaAnulacion     DateTime?

  items ItemVenta[]
  pagos PagoVenta[]
}

model ItemVenta {
  id Int @id @default(autoincrement())

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad       Float
  precioUnitario Float // copia del precio al momento de vender, no cambia si después se actualiza el precio del producto
  subtotal       Float // ya con el descuento de este ítem aplicado, si tiene uno

  // Descuento por producto (opcional) — alternativo al descuento de toda la
  // venta (Venta.descuentoTipo): solo puede haber uno de los dos activos a
  // la vez en una misma venta, para que el registro de qué se descontó sea
  // más claro.
  descuentoTipo  String? // "porcentaje" | "monto_fijo"
  descuentoValor Float?

  anulado            Boolean   @default(false)
  usuarioAnulacionId Int?
  usuarioAnulacion   Usuario?  @relation("ItemsAnuladosPorUsuario", fields: [usuarioAnulacionId], references: [id])
  motivoAnulacion    String?
  fechaAnulacion     DateTime?
}

model PagoVenta {
  id Int @id @default(autoincrement())

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id])

  medio String // "efectivo" | "tarjeta" | "credito"
  monto Float

  // Solo aplica cuando medio = "credito": a quién se le fía, y el registro
  // de cuándo/cómo se cobró después — puede pasar en una sesión de caja
  // distinta a la de la venta original (el cliente vuelve otro día).
  clienteNombre     String?
  cobrado           Boolean     @default(false)
  medioCobro        String? // "efectivo" | "tarjeta", cómo pagó al cobrarlo
  sesionCajaCobroId Int?
  sesionCajaCobro   SesionCaja? @relation("CobrosDeCredito", fields: [sesionCajaCobroId], references: [id])
  usuarioCobroId    Int?
  usuarioCobro      Usuario?    @relation("CobrosDeCreditoRegistradosPorUsuario", fields: [usuarioCobroId], references: [id])
  fechaCobro        DateTime?
}

// --- Módulo de Cámara Frigorífica ---
// Cada caja física en la cámara tiene identidad propia (no es solo un
// número de stock agregado como en MovimientoInventario/Producto.stockActual
// — eso sigue siendo el stock de "sala de venta"). La cámara es una zona de
// almacenamiento aparte: una caja entra a cámara, y solo cuando sale hacia
// "Sala de venta" es cuando corresponde generar un MovimientoInventario que
// aumente el stock vendible (Producto.stockActual) — igual que cualquier
// otra entrada. Ver server/routes/camara.ts para la lógica de cada flujo.

// Agrupa las cajas que se ingresaron juntas en una misma entrada (mismo
// producto, familia, peso total y costo neto) — para poder corregir,
// reimprimir o anular todas sus cajas de una vez, igual que el sistema que
// ya usaba el papá del usuario antes de este. Las cajas siguen siendo el
// registro real de stock (CajaCamara); el lote es solo el "grupo" al que
// pertenecen, y por sí solo no tiene saldo ni movimientos propios.
model LoteCamara {
  id Int @id @default(autoincrement())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  familiaNombre String // Vacuno | Cerdo | Pollo | Otros

  // Solo aplica (y es obligatorio) para familia "Vacuno" — de dónde viene
  // la carne: Nacional, Brasil o Paraguay. Null para las demás familias.
  procedencia String?

  cantidadCajas Int
  pesoTotalKg   Float
  costoNetoKg   Float
  totalNeto     Float // round(pesoTotalKg * costoNetoKg)

  // Factura de compra que originó este lote — opcionales porque los lotes
  // ya existentes (y los reconstruidos, ver más abajo) no la tienen.
  proveedorId   Int?
  proveedor     Proveedor? @relation(fields: [proveedorId], references: [id])
  numeroFactura String?

  fechaIngreso DateTime @default(now())

  creadoPorId Int
  creadoPor   Usuario @relation(fields: [creadoPorId], references: [id])

  // Verdadero para lotes armados automáticamente al agrupar cajas que ya
  // existían antes de que este modelo se agregara — informativo, no cambia
  // ningún comportamiento (ver server/lib/migraciones.ts).
  reconstruido Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  cajas        CajaCamara[]
  correcciones CorreccionLoteCamara[]
}

// Historial de correcciones a un lote — nunca se sobrescribe el lote sin
// dejar rastro, se agrega un registro nuevo por cada corrección (mismo
// principio que HistorialPrecio para productos).
model CorreccionLoteCamara {
  id Int @id @default(autoincrement())

  loteId Int
  lote   LoteCamara @relation(fields: [loteId], references: [id])

  familiaAnterior     String
  procedenciaAnterior String?
  productoAnterior    String // nombre del producto al momento de corregir, no un id — es solo un dato histórico para mostrar
  pesoTotalAnteriorKg Float
  costoAnteriorKg     Float

  familiaNueva     String
  procedenciaNueva String?
  productoNuevo    String
  pesoTotalNuevoKg Float
  costoNuevoKg     Float

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now())
}

// El número de caja de 6 dígitos que se imprime en la etiqueta se deriva
// del id (ej. id 28 → "000028") en el código de la aplicación, no se guarda
// aparte — id ya es único, inmutable y lo asigna la base de datos sola
// (nunca se calcula el próximo número en el navegador).
model CajaCamara {
  id Int @id @default(autoincrement())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  // El lote agrupa las cajas que se ingresaron juntas en una misma entrada
  // (mismo producto, familia, peso total y costo) — permite corregir,
  // reimprimir o anular todas sus cajas de una vez. Opcional solo por las
  // cajas que ya existían antes de que este campo se agregara (se les
  // reconstruye un lote propio automáticamente al iniciar el programa, ver
  // server/lib/migraciones.ts) — toda caja nueva siempre tiene lote.
  loteId Int?
  lote   LoteCamara? @relation(fields: [loteId], references: [id])

  // Familia fija elegida a mano al ingresar (Vacuno/Cerdo/Pollo/Otros) —
  // antes se sacaba sola de la categoría del producto; se guarda igual en
  // este campo para no duplicar la idea de "instantánea que no cambia si
  // el producto se recategoriza después".
  familiaNombre String

  // Solo aplica (y es obligatorio) para familia "Vacuno": Nacional, Brasil
  // o Paraguay — para saber de dónde viene esa carne. Null en las demás
  // familias.
  procedencia String?

  fechaIngreso  DateTime @default(now())
  pesoInicialKg Float
  saldoKg       Float
  costoNetoKg   Float

  // "en_camara" | "parcial" | "salida" | "ajuste_pendiente" | "anulada"
  estado String @default("en_camara")

  // Verdadero si el peso se repartió desde un total de lote (ej. factura
  // con 10 cajas y 225kg totales → 22,5kg estimados por caja) — se puede
  // corregir después con un ajuste auditado (MovimientoCamara).
  pesoEstimado Boolean @default(false)

  creadoPorId Int
  creadoPor   Usuario @relation(fields: [creadoPorId], references: [id])

  // Control de concurrencia optimista: cada operación que modifica el saldo
  // debe conocer la versión actual y la incrementa — si otra operación ya
  // la cambió mientras tanto, se rechaza en vez de pisar el cambio ajeno
  // (dos operadores no pueden descontar la misma caja al mismo tiempo).
  version Int @default(1)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  movimientos       MovimientoCamara[]
  esperados         InventarioCamaraEsperado[]
  escaneos          EscaneoInventarioCamara[]
  salidasMayoristas SalidaMayorista[]
}

// Cada cambio a una caja es un movimiento inmutable — nunca se reemplaza el
// historial editando solo el saldo de la caja (mismo principio que ya usa
// MovimientoInventario para el stock general).
model MovimientoCamara {
  id Int @id @default(autoincrement())

  cajaId Int
  caja   CajaCamara @relation(fields: [cajaId], references: [id])

  // "entrada" | "salida_parcial" | "salida_completa" | "transferencia" |
  // "consumo_produccion" | "merma" | "donacion" | "ajuste_entrada" | "ajuste_salida"
  tipo String

  pesoKg Float // siempre positivo — el signo lo da el tipo

  // "camara" | "sala_venta" | "mayorista" | "produccion" | "merma" | "donacion" | "otro"
  origen  String?
  destino String?

  motivo String?

  // Relación opcional con otro registro del sistema que originó este
  // movimiento (ej. "mayorista" + id de SalidaMayorista).
  referenciaTipo String?
  referenciaId   Int?

  usuarioId   Int
  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  dispositivo String? // descripción del origen (ej. "Celular Marco", "PC principal")

  // Evita que un reintento (ej. celular sin conexión que reintenta solo al
  // recuperar señal) duplique el movimiento — igual que el sistema ya
  // rechaza una segunda salida completa de la misma caja.
  claveIdempotencia String @unique

  creadoEn DateTime @default(now())
}

// Cada sesión de inventario por escaneo agrupa una revisión completa de la
// cámara — solo puede haber una abierta a la vez (mismo patrón que SesionCaja).
model SesionInventarioCamara {
  id Int @id @default(autoincrement())

  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?

  iniciadoPorId Int
  iniciadoPor   Usuario @relation("SesionesCamaraIniciadasPorUsuario", fields: [iniciadoPorId], references: [id])

  finalizadoPorId Int?
  finalizadoPor   Usuario? @relation("SesionesCamaraFinalizadasPorUsuario", fields: [finalizadoPorId], references: [id])

  // "abierta" | "finalizada" | "conciliada"
  estado        String  @default("abierta")
  observaciones String?

  esperados InventarioCamaraEsperado[]
  escaneos  EscaneoInventarioCamara[]
}

// Instantánea de todas las cajas con saldo positivo al momento de ABRIR la
// sesión de inventario — indispensable para no generar falsos faltantes si
// entra o sale una caja mientras el conteo está en curso.
model InventarioCamaraEsperado {
  id Int @id @default(autoincrement())

  sesionId Int
  sesion   SesionInventarioCamara @relation(fields: [sesionId], references: [id])

  cajaId Int
  caja   CajaCamara @relation(fields: [cajaId], references: [id])

  saldoEsperadoKg Float
  estadoEsperado  String
  capturadoEn     DateTime @default(now())

  @@unique([sesionId, cajaId])
}

// Un escaneo por sesión y caja — el índice único evita que un doble escaneo
// (ej. el operador pasa la pistola dos veces sin querer) duplique el conteo.
model EscaneoInventarioCamara {
  id Int @id @default(autoincrement())

  sesionId Int
  sesion   SesionInventarioCamara @relation(fields: [sesionId], references: [id])

  cajaId Int
  caja   CajaCamara @relation(fields: [cajaId], references: [id])

  escaneadoEn DateTime @default(now())

  escaneadoPorId Int
  escaneadoPor   Usuario @relation(fields: [escaneadoPorId], references: [id])
  dispositivo    String?

  estadoAlEscanear  String
  saldoAlEscanearKg Float

  @@unique([sesionId, cajaId])
}

// Salida de cámara hacia un cliente mayorista — registro simple y propio
// (no pasa por toda la lógica de Caja con sesión abierta/medios de pago),
// pensado solo para llevar el rastro de cantidad, precio y si ya se cobró.
model SalidaMayorista {
  id Int @id @default(autoincrement())

  fecha DateTime @default(now())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidadKg  Float
  precioTotal Float

  // "pagado" | "pendiente"
  estadoPago String @default("pendiente")

  clienteNombre String?

  cajaCamaraId Int?
  cajaCamara   CajaCamara? @relation(fields: [cajaCamaraId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  observaciones String?

  // Anular una venta al por mayor ya registrada (ej. se ingresó mal, o el
  // cliente se arrepintió) — solo se puede si la caja de cámara de origen
  // no tuvo ningún movimiento después de esta venta, mismo principio que
  // "Anular una entrada" de cámara. Se guarda el registro igual que
  // cualquier otra anulación del sistema (usuario, motivo, fecha) en vez
  // de borrar la fila.
  anulada            Boolean   @default(false)
  usuarioAnulacionId Int?
  usuarioAnulacion   Usuario?  @relation("SalidasMayoristasAnuladasPorUsuario", fields: [usuarioAnulacionId], references: [id])
  motivoAnulacion    String?
  fechaAnulacion     DateTime?
}
