DATABASE_URL="file:./dev.db"
PORT=5175

# Sincronización con lagrancarniceria.com (catálogo público y pedidos web).
# Si se dejan vacíos, el sync queda desactivado sin afectar el resto del POS.
# WEB_SYNC_URL: URL base del sitio (ej. https://lagrancarniceria.com).
# SYNC_API_KEY: llave acotada solo para sincronizar catálogo/pedidos — no es
# la contraseña de la base de datos. Se genera del lado de la web.
WEB_SYNC_URL=
SYNC_API_KEY=
